{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Berry AI Studio",
  "version": "0.1.3",
  "identifier": "com.berryuiki.berryaistudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Berry AI Studio",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "Local asset manager and prompt studio for AI-generated images",
    "longDescription": "Berry AI Studio is an open-source local asset manager and studio for AI-generated images and workflows supporting AUTOMATIC1111, ComfyUI, NovelAI, InvokeAI, Fooocus, EasyDiffusion, and Stable Swarm.",
    "copyright": "Copyright © 2026 BerryUIKI",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
