{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Berry-AIGC-Toolbox",
  "version": "3.0.0",
  "identifier": "com.berryuiki.berryaigctoolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Berry AIGC Toolbox",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics",
    "shortDescription": "Metadata indexer and viewer for AI-generated images",
    "longDescription": "Berry AIGC Toolbox is an open-source metadata indexer and viewer for AI-generated images supporting AUTOMATIC1111, ComfyUI, NovelAI, InvokeAI, Fooocus, EasyDiffusion, and Stable Swarm.",
    "copyright": "Copyright © 2026 BerryUIKI",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
