<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Temporarily suppress warnings during initial development -->
    <!-- Will be addressed in a future refactoring PR -->
    <NoWarn>$(NoWarn);CA1510;CA1866;CA1310;CA1850;CS8618;CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>